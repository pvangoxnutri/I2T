{
  "name": "i2t",
  "productName": "Image 2 Transition",
  "version": "0.1.0",
  "description": "Image 2 Transition — AI frame-to-frame property video studio for real estate",
  "main": "./out/main/index.js",
  "private": true,
  "author": "Image 2 Transition",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "build:win": "npm run typecheck && electron-vite build && electron-builder --win --x64",
    "dist": "npm run build:win",
    "dist:win": "npm run build:win",
    "pack:dir": "electron-vite build && electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "com.image2transition.i2t",
    "productName": "Image 2 Transition",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "artifactName": "I2T Setup.exe",
      "shortcutName": "Image 2 Transition",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "I2T Portable.exe"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^35.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  }
}
